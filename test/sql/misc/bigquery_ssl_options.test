# name: test/sql/misc/bigquery_ssl_options.test
# description: Check opt-in defaults and configuration of Schannel revocation settings without network requests
# group: [misc]

require bigquery

query T
SELECT current_setting('bq_curl_ssl_revocation_mode');
----
default

query I
SELECT count(*) FROM duckdb_settings() WHERE name IN ('bq_curl_ssl_no_revoke', 'bq_curl_ssl_revoke_best_effort');
----
0

statement ok
SET bq_curl_ssl_revocation_mode = 'best_effort';

query T
SELECT current_setting('bq_curl_ssl_revocation_mode');
----
best_effort

statement ok
SET bq_curl_ssl_revocation_mode = ' DISABLED ';

query T
SELECT current_setting('bq_curl_ssl_revocation_mode');
----
disabled

statement ok
SET bq_curl_ssl_revocation_mode = ' DeFaUlT ';

query T
SELECT current_setting('bq_curl_ssl_revocation_mode');
----
default

statement ok
SET bq_curl_ssl_revocation_mode = E'\tBeSt_EfFoRt\n';

query T
SELECT current_setting('bq_curl_ssl_revocation_mode');
----
best_effort

statement error
SET bq_curl_ssl_revocation_mode = 'strict';
----
bq_curl_ssl_revocation_mode must be one of: default, best_effort, disabled

statement error
SET bq_curl_ssl_revocation_mode = '';
----
bq_curl_ssl_revocation_mode must be one of: default, best_effort, disabled

statement error
SET bq_curl_ssl_revocation_mode = '   ';
----
bq_curl_ssl_revocation_mode must be one of: default, best_effort, disabled

statement error
SET bq_curl_ssl_revocation_mode = NULL;
----
bq_curl_ssl_revocation_mode cannot be NULL

query T
SELECT current_setting('bq_curl_ssl_revocation_mode');
----
best_effort

statement ok
RESET bq_curl_ssl_revocation_mode;

query T
SELECT current_setting('bq_curl_ssl_revocation_mode');
----
default
