# name: test/sql/functions/function_bigquery_scan_filter_pushdown.test
# description: WHERE filters must survive disabled pushdown and explicit scan filters
# group: [functions]

require bigquery

require-env BQ_TEST_PROJECT

require-env BQ_TEST_DATASET

# Keep aggregate pushdown from replacing the scan paths under test.
statement ok
SET bq_enable_aggregate_pushdown = false;

statement ok
FROM bigquery_execute('{BQ_TEST_PROJECT}', '
    CREATE OR REPLACE TABLE `{BQ_TEST_PROJECT}.{BQ_TEST_DATASET}.scan_filter_pushdown_test` AS
    SELECT 1 AS a, "BER" AS station_abbr, TIMESTAMP "2026-10-17 00:00:00" AS reference_timestamp
    UNION ALL
    SELECT 3 AS a, "HAM" AS station_abbr, TIMESTAMP "2026-10-18 00:00:00" AS reference_timestamp
    UNION ALL
    SELECT 5 AS a, "BER" AS station_abbr, TIMESTAMP "2026-10-17 12:00:00" AS reference_timestamp
');

foreach pushdown false true

statement ok
SET bq_experimental_filter_pushdown = {pushdown};

# The column used by a local filter may be absent from the output projection.
query II
SELECT count(*), sum(a) FROM bigquery_scan('{BQ_TEST_PROJECT}.{BQ_TEST_DATASET}.scan_filter_pushdown_test')
WHERE station_abbr = 'BER';
----
2	6

query I
SELECT count(*) FROM bigquery_scan('{BQ_TEST_PROJECT}.{BQ_TEST_DATASET}.scan_filter_pushdown_test')
WHERE reference_timestamp >= TIMESTAMP '2026-10-17 00:00:00'
  AND reference_timestamp < TIMESTAMP '2026-10-18 00:00:00';
----
2

# Explicit restrictions and SQL WHERE predicates must both apply, with their own precedence.
query I
SELECT count(*) FROM bigquery_scan('{BQ_TEST_PROJECT}.{BQ_TEST_DATASET}.scan_filter_pushdown_test',
    filter := 'a = 3 OR a = 1') WHERE station_abbr = 'BER';
----
1

# Query result scans share the Storage Read scan implementation.
# REST results have no Storage Read row restriction and must retain local filters.
foreach use_rest_api false true

query I
SELECT count(*) FROM bigquery_query('{BQ_TEST_PROJECT}',
    'SELECT * FROM `{BQ_TEST_PROJECT}.{BQ_TEST_DATASET}.scan_filter_pushdown_test`', use_rest_api := {use_rest_api})
WHERE station_abbr = 'BER';
----
2

endloop

endloop

statement ok
SET bq_experimental_filter_pushdown = false;

query II
EXPLAIN SELECT count(*) FROM bigquery_scan('{BQ_TEST_PROJECT}.{BQ_TEST_DATASET}.scan_filter_pushdown_test')
WHERE station_abbr = 'BER';
----
physical_plan	<REGEX>:.*FILTER.*

statement ok
SET bq_experimental_filter_pushdown = true;

# Changing the setting after PREPARE must not discard filters already owned by the scan.
statement ok
PREPARE filtered_scan AS
SELECT count(*) FROM bigquery_scan('{BQ_TEST_PROJECT}.{BQ_TEST_DATASET}.scan_filter_pushdown_test')
WHERE station_abbr = 'BER';

statement ok
SET bq_experimental_filter_pushdown = false;

query I
EXECUTE filtered_scan;
----
2

statement ok
DEALLOCATE filtered_scan;

statement ok
SET bq_experimental_filter_pushdown = true;

statement ok
FROM bigquery_execute('{BQ_TEST_PROJECT}', 'DROP TABLE `{BQ_TEST_PROJECT}.{BQ_TEST_DATASET}.scan_filter_pushdown_test`');
