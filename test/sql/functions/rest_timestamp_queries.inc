# Shared TIMESTAMP assertions for live BigQuery and local REST mocks.
# The caller provides a rest_timestamp_query(query_text) table macro.

foreach mode inline polled paged

query IIT
SELECT micros, epoch_us(ts), CAST(ts AS VARCHAR)
FROM rest_timestamp_query('
    SELECT micros, TIMESTAMP_MICROS(micros) AS ts
    FROM UNNEST([
        -62135596800000000, -62135596799999999, -1000001, -1000000, -1, 0, 1,
        100000, 120000, 123000, 123400, 123450, 123456, 1123456,
        253402300799999998, 253402300799999999
    ]) AS micros
    ORDER BY micros
    -- rest_timestamp_{mode}
');
----
-62135596800000000	-62135596800000000	0001-01-01 00:00:00
-62135596799999999	-62135596799999999	0001-01-01 00:00:00.000001
-1000001	-1000001	1969-12-31 23:59:58.999999
-1000000	-1000000	1969-12-31 23:59:59
-1	-1	1969-12-31 23:59:59.999999
0	0	1970-01-01 00:00:00
1	1	1970-01-01 00:00:00.000001
100000	100000	1970-01-01 00:00:00.1
120000	120000	1970-01-01 00:00:00.12
123000	123000	1970-01-01 00:00:00.123
123400	123400	1970-01-01 00:00:00.1234
123450	123450	1970-01-01 00:00:00.12345
123456	123456	1970-01-01 00:00:00.123456
1123456	1123456	1970-01-01 00:00:01.123456
253402300799999998	253402300799999998	9999-12-31 23:59:59.999998
253402300799999999	253402300799999999	9999-12-31 23:59:59.999999

endloop

query IITTI
SELECT epoch_us(record.before_epoch), epoch_us(record.last), CAST(record.civil AS VARCHAR),
       list_transform(instants, lambda ts: epoch_us(ts)), missing IS NULL
FROM rest_timestamp_query('
    SELECT STRUCT(
        TIMESTAMP_MICROS(-1) AS before_epoch,
        TIMESTAMP_MICROS(253402300799999999) AS last,
        DATETIME "2024-01-15 12:34:56.123456" AS civil
    ) AS record,
    [TIMESTAMP_MICROS(-1000001), TIMESTAMP_MICROS(-1), TIMESTAMP_MICROS(0),
     TIMESTAMP_MICROS(1), TIMESTAMP_MICROS(253402300799999999),
     TIMESTAMP_MICROS(-62135596800000000)] AS instants,
    CAST(NULL AS TIMESTAMP) AS missing
    -- rest_timestamp_nested
');
----
-1	253402300799999999	2024-01-15 12:34:56.123456	[-1000001, -1, 0, 1, 253402300799999999, -62135596800000000]	true
