# name: test/sql/secrets/secrets_attach_secret_option.test
# description: Test that ATTACH ... (SECRET name) selects credentials by name instead of by scope
# group: [secrets]

require bigquery

statement ok
SET bq_auth_timeout_s=10;

# Two secrets share the same scope. Scope lookup breaks the tie on the alphabetically
# smallest name, so the failing secret wins unless ATTACH names the working one.
statement ok
CREATE SECRET bq_named_a_broken (
    TYPE bigquery,
    PROVIDER config,
    SCOPE 'bq://named-secret-project',
    REFRESH_TOKEN '1//test-refresh-token',
    CLIENT_ID 'test-client-id.apps.googleusercontent.com',
    CLIENT_SECRET 'test-client-secret',
    TOKEN_URI 'http://127.0.0.1:1/token'
);

statement ok
CREATE SECRET bq_named_b_working (
    TYPE bigquery,
    PROVIDER config,
    SCOPE 'bq://named-secret-project',
    ACCESS_TOKEN 'ya29.test-access-token'
);

query I
SELECT name FROM which_secret('bq://named-secret-project', 'bigquery');
----
bq_named_a_broken

statement error
ATTACH 'project=named-secret-project' AS bq_scope_lookup (TYPE bigquery);
----
<REGEX>:.*BigQuery Authentication Failed.*

statement ok
ATTACH 'project=named-secret-project' AS bq_named_working (TYPE bigquery, SECRET bq_named_b_working);

statement error
ATTACH 'project=named-secret-project' AS bq_named_broken (TYPE bigquery, SECRET bq_named_a_broken);
----
<REGEX>:.*BigQuery Authentication Failed.*

statement error
ATTACH 'project=named-secret-project' AS bq_named_missing (TYPE bigquery, SECRET bq_named_does_not_exist);
----
Invalid Input Error: BigQuery secret 'bq_named_does_not_exist' does not exist

statement error
ATTACH 'project=named-secret-project' AS bq_named_empty (TYPE bigquery, SECRET '');
----
Binder Error: The SECRET option of ATTACH ... (TYPE bigquery) must not be empty

statement ok
DETACH bq_named_working;

statement ok
DROP SECRET bq_named_a_broken;

statement ok
DROP SECRET bq_named_b_working;
